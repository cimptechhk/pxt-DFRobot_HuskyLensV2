<xml xmlns="http://www.w3.org/1999/xhtml">
  <block type="pxt-on-start">
    <statement name="HANDLER">
      <block type="huskylens2_I2CInit">
        <next>
          <block type="huskylens2_switchAlgorithm">
            <field name="algorithmId">huskylens2.Algorithm.AlgorithmFallDownRecognition</field>
          </block>
        </next>
      </block>
    </statement>
  </block>
  <block type="device_forever">
    <statement name="HANDLER">
      <block type="huskylens2_requestFallDetectionData">
        <next>
          <block type="controls_if">
            <value name="IF0">
              <shadow type="logic_boolean">
                <field name="BOOL">TRUE</field>
              </shadow>
              <block type="huskylens2_fallDetected"></block>
            </value>
            <statement name="DO0">
              <block type="basic_show_icon">
                <field name="i">IconNames.No</field>
              </block>
            </statement>
          </block>
        </next>
      </block>
    </statement>
  </block>
</xml>
